---
const links = [
	{ href: '/', label: 'Home' },
	{ href: '/about', label: 'About' },
	{ href: '/work', label: 'Work' },
	{ href: '/posts', label: 'Writing' },
];

const isActive = (href: string) =>
	href === '/'
		? Astro.url.pathname === '/'
		: Astro.url.pathname === href || Astro.url.pathname.startsWith(`${href}/`);
---

<header class="flex flex-wrap items-center justify-end gap-4 px-6 py-5">
	<button
		type="button"
		class="cursor-pointer rounded-md p-1 text-muted transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
		aria-label="Switch to dark mode"
		aria-pressed="false"
		data-theme-toggle
	>
		<svg
			class="size-5 dark:hidden"
			viewBox="0 0 256 256"
			fill="currentColor"
			aria-hidden="true"
		>
			<path d="M233.54,142.23a8,8,0,0,0-8-2,88.08,88.08,0,0,1-109.8-109.8,8,8,0,0,0-10-10,104.84,104.84,0,0,0-52.91,37A104,104,0,0,0,136,224a103.09,103.09,0,0,0,62.52-20.88,104.84,104.84,0,0,0,37-52.91A8,8,0,0,0,233.54,142.23ZM188.9,190.34A88,88,0,0,1,65.66,67.11a89,89,0,0,1,31.4-26A106,106,0,0,0,96,56,104.11,104.11,0,0,0,200,160a106,106,0,0,0,14.92-1.06A89,89,0,0,1,188.9,190.34Z"></path>
		</svg>
		<svg
			class="hidden size-5 dark:block"
			viewBox="0 0 256 256"
			fill="currentColor"
			aria-hidden="true"
		>
			<path d="M120,40V16a8,8,0,0,1,16,0V40a8,8,0,0,1-16,0Zm72,88a64,64,0,1,1-64-64A64.07,64.07,0,0,1,192,128Zm-16,0a48,48,0,1,0-48,48A48.05,48.05,0,0,0,176,128ZM58.34,69.66A8,8,0,0,0,69.66,58.34l-16-16A8,8,0,0,0,42.34,53.66Zm0,116.68-16,16a8,8,0,0,0,11.32,11.32l16-16a8,8,0,0,0-11.32-11.32ZM192,72a8,8,0,0,0,5.66-2.34l16-16a8,8,0,0,0-11.32-11.32l-16,16A8,8,0,0,0,192,72Zm5.66,114.34a8,8,0,0,0-11.32,11.32l16,16a8,8,0,0,0,11.32-11.32ZM48,128a8,8,0,0,0-8-8H16a8,8,0,0,0,0,16H40A8,8,0,0,0,48,128Zm80,80a8,8,0,0,0-8,8v24a8,8,0,0,0,16,0V216A8,8,0,0,0,128,208Zm112-88H216a8,8,0,0,0,0,16h24a8,8,0,0,0,0-16Z"></path>
		</svg>
	</button>
	<nav aria-label="Primary navigation">
		<ul class="flex flex-wrap items-center gap-x-5 gap-y-2">
			{
				links.map(({ href, label }) => (
					<li>
						<a
							class:list={[
								'text-sm no-underline transition-colors hover:text-accent',
								isActive(href) ? 'text-accent' : 'text-body',
							]}
							href={href}
							aria-current={isActive(href) ? 'page' : undefined}
						>
							{label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>

<script>
	const toggle = document.querySelector('[data-theme-toggle]');
	const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');

	function updateToggle() {
		const isDark = document.documentElement.classList.contains('dark');
		toggle?.setAttribute('aria-label', `Switch to ${isDark ? 'light' : 'dark'} mode`);
		toggle?.setAttribute('aria-pressed', String(isDark));
	}

	toggle?.addEventListener('click', () => {
		const isDark = !document.documentElement.classList.contains('dark');
		document.documentElement.classList.toggle('dark', isDark);
		localStorage.setItem('theme', isDark ? 'dark' : 'light');
		updateToggle();
	});

	systemTheme.addEventListener('change', (event) => {
		if (!localStorage.getItem('theme')) {
			document.documentElement.classList.toggle('dark', event.matches);
			updateToggle();
		}
	});

	updateToggle();
</script>
