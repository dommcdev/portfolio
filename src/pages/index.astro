---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="flex min-h-svh flex-col">
		<Header />
		<main class="grid flex-1 place-items-center px-6 pb-20 text-center">
			<div>
				<h1 class="text-4xl font-bold tracking-tight text-ink sm:text-6xl">Dominic McDevitt</h1>
				<p class="mt-3 text-lg text-muted sm:text-xl">Software and DevOps Engineer</p>
			</div>
		</main>
	</body>
</html>
