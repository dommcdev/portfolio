---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body
		class="m-0 bg-[linear-gradient(rgb(229_233_240/50%),#fff)] bg-no-repeat font-sans text-lg leading-[1.7] text-body [background-size:100%_600px] [overflow-wrap:break-word] min-[721px]:text-xl"
	>
		<Header />
		<main class="mx-auto w-[60rem] max-w-[calc(100%_-_2em)] p-[1em] min-[721px]:px-[1em] min-[721px]:py-[3em]">
			<section>
				<ul class="m-0 flex list-none flex-wrap gap-[0.5em] p-0 min-[721px]:gap-8">
					{
						posts.map((post, index) => (
							<li
								class:list={[
									'w-full text-center min-[721px]:w-[calc(50%_-_1rem)] min-[721px]:text-left',
									{ 'min-[721px]:mb-4 min-[721px]:w-full min-[721px]:text-center': index === 0 },
								]}
							>
								<a class="group block no-underline" href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
										<Image
											class:list={[
												'mb-2 h-auto max-w-full rounded-xl transition-all duration-200 ease-in-out group-hover:shadow-raised',
												{ 'w-full': index === 0 },
											]}
											width={720}
											height={360}
											src={post.data.heroImage}
											alt=""
										/>
									)}
									<h4
										class:list={[
											'm-0 text-[1.563em] leading-none font-bold text-ink no-underline transition-all duration-200 ease-in-out group-hover:text-accent',
											{ 'min-[721px]:text-[2.369rem]': index === 0 },
										]}
									>
										{post.data.title}
									</h4>
									<p class="m-0 text-muted no-underline transition-all duration-200 ease-in-out group-hover:text-accent">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
