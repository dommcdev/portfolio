---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const dateFormatter = new Intl.DateTimeFormat('en', {
	year: 'numeric',
	month: 'short',
	day: 'numeric',
});
---

<BaseLayout title="Writing">
	<main class="flex-1">
		<ul>
			{
				posts.map((post) => (
					<li class="border-b border-dashed border-line">
						<a
							class="group flex items-baseline justify-between gap-6 px-6 py-5 no-underline transition-colors hover:bg-subtle/30 sm:px-10"
							href={`/posts/${post.id}/`}
						>
							<span class="font-medium text-body transition-colors group-hover:text-accent">
								{post.data.title}
							</span>
							<time class="shrink-0 font-mono text-sm text-muted" datetime={post.data.pubDate.toISOString()}>
								{dateFormatter.format(post.data.pubDate)}
							</time>
						</a>
					</li>
				))
			}
		</ul>
	</main>
</BaseLayout>
