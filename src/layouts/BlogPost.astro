---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body
		class="m-0 bg-[linear-gradient(rgb(229_233_240/50%),#fff)] bg-no-repeat font-sans text-lg leading-[1.7] text-body [background-size:100%_600px] [overflow-wrap:break-word] min-[721px]:text-xl"
	>
		<Header />
		<main class="m-0 w-[calc(100%_-_2em)] max-w-full p-[1em] min-[721px]:px-[1em] min-[721px]:py-[3em]">
			<article>
				<div class="w-full">
					{
						heroImage && (
							<Image
								class="mx-auto block h-auto max-w-full rounded-xl shadow-raised"
								width={1020}
								height={510}
								src={heroImage}
								alt=""
							/>
						)
					}
				</div>
				<div
					class="mx-auto w-[45rem] max-w-[calc(100%_-_2em)] p-[1em] text-body [&_a]:text-accent [&_a:hover]:text-accent [&_b]:font-bold [&_blockquote]:m-0 [&_blockquote]:border-l-4 [&_blockquote]:border-accent [&_blockquote]:pl-5 [&_blockquote]:text-[1.333em] [&_code]:rounded-sm [&_code]:bg-subtle [&_code]:px-[5px] [&_code]:py-0.5 [&_h1]:mb-2 [&_h1]:text-[3.052em] [&_h2]:mb-2 [&_h2]:text-[2.441em] [&_h3]:mb-2 [&_h3]:text-[1.953em] [&_h4]:mb-2 [&_h4]:text-[1.563em] [&_h5]:mb-2 [&_h5]:text-[1.25em] [&_h6]:mb-2 [&_h6]:text-[0.67em] [&_h1]:leading-[1.2] [&_h2]:leading-[1.2] [&_h3]:leading-[1.2] [&_h4]:leading-[1.2] [&_h5]:leading-[1.2] [&_h6]:leading-[1.2] [&_h1]:font-bold [&_h2]:font-bold [&_h3]:font-bold [&_h4]:font-bold [&_h5]:font-bold [&_h6]:font-bold [&_h1]:text-ink [&_h2]:text-ink [&_h3]:text-ink [&_h4]:text-ink [&_h5]:text-ink [&_h6]:text-ink [&_hr]:border-0 [&_hr]:border-t [&_hr]:border-subtle [&_img]:h-auto [&_img]:max-w-full [&_img]:rounded-lg [&_input]:text-base [&_li]:list-item [&_ol]:my-[1em] [&_ol]:list-decimal [&_ol]:pl-10 [&_p]:mb-[2em] [&_pre]:rounded-lg [&_pre]:p-[1.5em] [&_pre>code]:[all:unset] [&_strong]:font-bold [&_table]:w-full [&_textarea]:w-full [&_textarea]:text-base [&_ul]:my-[1em] [&_ul]:list-disc [&_ul]:pl-10"
				>
					<div class="mb-[1em] py-[1em] text-center leading-none">
						<div class="mb-[0.5em] text-muted">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="italic">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1 class="!mt-0 !mb-[0.5em]">{title}</h1>
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
